{
  "installCommand": "npm install --legacy-peer-deps && npm install ajv ajv-keywords --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 12,22 * * *"
    }
  ],
  "functions": {
    "api/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
